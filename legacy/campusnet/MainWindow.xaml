<Window x:Class="CampusNetWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CampusNet · 苏大校园网" Width="1024" Height="680"
        MinWidth="920" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F4F7FB" FontFamily="{StaticResource AppFont}"
        Closing="OnWindowClosing" Closed="OnWindowClosed">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <SolidColorBrush x:Key="Ink" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#667085"/>
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="Border" Color="#E5EAF1"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D9E1EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="True">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                                    Background="#CBD5E1" VerticalAlignment="Center" DockPanel.Dock="Left">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White"
                                         HorizontalAlignment="Left" Margin="3"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="#F8FAFC" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EAF1FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F0F5FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#D9E1EC" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#101828" Padding="22,24,22,20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="21" Background="White">
                                <Image Source="/CampusNet;component/Assets/suda-logo.png" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CampusNet" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="SUDA NETWORK" Foreground="#64748B" FontSize="9" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="工作区" Foreground="#64748B" FontSize="10" FontWeight="SemiBold"
                                   Margin="4,38,0,10"/>
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="概览" Click="ShowDashboard"/>
                        <Button x:Name="NavAccounts" Style="{StaticResource NavButton}" Content="账号管理" Click="ShowAccounts"/>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="偏好设置" Click="ShowSettings"/>
                        <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Content="运行日志" Click="ShowLogs"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#172033" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SideStatusDot" Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SideStatus" Text="正在检测" Foreground="#E2E8F0" FontSize="12"
                                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="SideAccount" Text="未选择账号" Foreground="#7C8AA5" FontSize="11" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowDrag">
                    <Grid Margin="28,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="网络概览" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="PageSubtitle" Text="校园网连接状态与自动守护" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="16" Padding="11,6" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusShort" Text="检测中" FontSize="11" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource WindowButton}" Content="—" Click="MinimizeWindow"/>
                            <Button Style="{StaticResource WindowButton}" Content="□" Click="MaximizeWindow"/>
                            <Button Style="{StaticResource WindowButton}" Content="×" Click="CloseWindow"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="28,24,28,26">
                    <Grid x:Name="DashboardPage" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="26" Background="#F9FBFF">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NETWORK STATUS" Foreground="#2563EB" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="StatusText" Text="正在检测网络" FontSize="30" FontWeight="Bold" Margin="0,10,0,7"/>
                                    <TextBlock x:Name="StatusMessage" Text="正在确认互联网与校园网网关状态" Foreground="{StaticResource Muted}" FontSize="13"/>
                                    <TextBlock x:Name="NextCheckText" Text="" Foreground="#98A2B3" FontSize="11" Margin="0,12,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button x:Name="PauseButton" Content="暂停重连" Padding="16,12" Margin="0,0,10,0" Click="TogglePause"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="立即连接" Padding="22,12" Click="ConnectNow"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,16">
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="当前账号" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="CurrentAccountText" Text="未选择" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                    <TextBlock x:Name="CurrentOperatorText" Text="请在账号管理中添加账号" Foreground="#98A2B3" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="8,0">
                                <StackPanel>
                                    <TextBlock Text="最近检测" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="LastCheckText" Text="--:--:--" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                    <TextBlock Text="自动更新，无需刷新" Foreground="#98A2B3" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="守护策略" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="GuardModeText" Text="自动重连" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                    <TextBlock x:Name="IntervalText" Text="每 10 秒检测" Foreground="#98A2B3" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,13">
                                    <TextBlock Text="最近活动" FontSize="14" FontWeight="SemiBold"/>
                                    <Button Content="查看全部" DockPanel.Dock="Right" Padding="10,5" Click="ShowLogs"/>
                                </DockPanel>
                                <ListBox x:Name="DashboardLogs" Grid.Row="1" ItemsSource="{Binding DashboardLogItems}"
                                         DisplayMemberPath="Display" IsHitTestVisible="False" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="AccountsPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="账号列表" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="当前账号优先，其余启用账号依次尝试" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Content="新建账号" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="12,7" Click="NewAccount"/>
                                </DockPanel>
                                <ListBox x:Name="AccountsList" Grid.Row="1" SelectionChanged="AccountSelected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding DisplayDetails}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="当前" Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Foreground="#2563EB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="账号详情" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EditorHint" Text="选择左侧账号，或新建一个账号" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,20"/>
                                    <TextBlock Text="校园网账号" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <TextBox x:Name="UsernameInput" ToolTip="学号后可带 @zgyd、@cucc 或 @ctc"/>
                                    <TextBlock Text="登录密码" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,7"/>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput"/>
                                        <TextBox x:Name="PasswordVisibleInput" Visibility="Collapsed"/>
                                    </Grid>
                                    <CheckBox x:Name="ShowPasswordInput" Content="显示密码" Margin="0,12,0,0" Checked="TogglePasswordVisibility" Unchecked="TogglePasswordVisibility"/>
                                    <CheckBox x:Name="EnabledInput" Content="启用此账号参与自动登录" Margin="0,14,0,0"/>
                                    <Border Background="#F8FAFC" CornerRadius="9" Padding="12" Margin="0,20,0,18">
                                        <TextBlock Text="运营商后缀示例：移动 @zgyd，联通 @cucc，电信 @ctc；校园网账号无需后缀。" Foreground="{StaticResource Muted}" FontSize="11"/>
                                    </Border>
                                    <Button Style="{StaticResource PrimaryButton}" Content="保存账号" Click="SaveAccount"/>
                                    <UniformGrid Columns="2" Margin="0,10,0,0">
                                        <Button Content="设为当前" Margin="0,0,5,0" Click="SetCurrentAccount"/>
                                        <Button Content="删除账号" Margin="5,0,0,0" Click="DeleteAccount"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="自动化行为" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="控制应用在后台如何工作" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,22"/>
                                <CheckBox x:Name="AutoReconnectInput" Content="断线后自动重新认证" Margin="0,0,0,18"/>
                                <CheckBox x:Name="AutoHotspotInput" Content="网络恢复后开启移动热点" Margin="0,0,0,18"/>
                                <CheckBox x:Name="AutoStartInput" Content="登录 Windows 后后台启动" Margin="0,0,0,18"/>
                                <CheckBox x:Name="CloseToTrayInput" Content="关闭窗口时最小化到托盘" Margin="0,0,0,18"/>
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                    <TextBlock Text="热点功能依赖 Windows 移动热点组件；若系统未响应，可使用右侧入口打开系统设置。" Foreground="{StaticResource Muted}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0" Padding="24">
                            <StackPanel>
                                <TextBlock Text="网络参数" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="保持默认值即可适配苏大校园网" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,22"/>
                                <TextBlock Text="认证网关" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <TextBox x:Name="GatewayInput"/>
                                <TextBlock Text="检测间隔（3–300 秒）" FontSize="12" FontWeight="SemiBold" Margin="0,18,0,7"/>
                                <TextBox x:Name="IntervalInput"/>
                                <TextBlock Text="失败后会自动延长重试间隔，避免频繁请求网关。为保护密码，仅支持私有 IPv4 网关。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,20"/>
                                <Button Content="打开 Windows 热点设置" Click="OpenHotspotSettings"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="保存并应用设置" Margin="0,12,0,0" Click="SaveSettings"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="LogsPage" Style="{StaticResource Card}" Visibility="Collapsed" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="运行日志" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="日志仅保留在当前会话，不记录账号密码" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="复制日志" Padding="12,7" Margin="0,0,8,0" Click="CopyLogs"/>
                                    <Button Content="清空日志" Padding="12,7" Click="ClearLogs"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="LogsList" Grid.Row="1" DisplayMemberPath="Display" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
