<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SudaLink</AssemblyName>
    <RootNamespace>SudaLink</RootNamespace>
    <Version>4.8.1</Version>
    <AssemblyVersion>4.8.1.0</AssemblyVersion>
    <FileVersion>4.8.1.0</FileVersion>
    <Product>SudaLink</Product>
    <Description>苏大校园网自动登录助手</Description>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <!-- 不写这一行 SDK 会塞进默认清单（asInvoker），app.manifest 里的
         requireAdministrator 根本不会生效 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 自己写入口点：开机时 WPF 可能因提交内存不足起不来，需要在真正创建
         Application 之前做延迟重试（见 Program.cs）。指定 StartupObject 后
         App.g.cs 里自动生成的 Main 会被忽略。 -->
    <StartupObject>SudaLink.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- WFAC010：WinForms 分析器希望 DPI 用项目属性配置。这里是 WPF 主体 + 一个
         NotifyIcon，WPF 的 per-monitor v2 必须写在清单里，所以保留清单并忽略该提示。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Text" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 网关的结果页是 GBK/GB2312，.NET 默认只带 UTF-8，不注册代码页会直接抛异常 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <Resource Include="Assets\suda-logo.png" />
    <Resource Include="Assets\grain.png" />
    <Resource Include="Assets\backdrop-light.jpg" />
    <Resource Include="Assets\backdrop-dark.jpg" />
  </ItemGroup>
</Project>
