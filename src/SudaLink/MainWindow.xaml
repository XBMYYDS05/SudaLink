<Window x:Class="SudaLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:SudaLink.Controls"
        Title="SudaLink" Width="488" Height="718" MinWidth="448" MinHeight="608"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="#00000000" FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Closing="OnWindowClosing" Closed="OnWindowClosed" StateChanged="OnWindowStateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="8" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Storyboard x:Key="StatusPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.6" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.6" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="StatusHalo" Storyboard.TargetProperty="Opacity"
                             From="0.5" To="0" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <Storyboard x:Key="Entrance">
            <DoubleAnimation Storyboard.TargetName="ContentRoot" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="ContentShift" Storyboard.TargetProperty="Y"
                             From="12" To="0" Duration="0:0:0.38" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource Entrance}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- 窗口本体是一块 20px 圆角的玻璃。分层透明窗口自绘圆角、光边与投影，
         不再依赖 DWM 的 8px 系统圆角（外圈比内圈还尖，这就是“四角丑”的来源）。
         背景必须用 #00000000（透明黑）而不是 Transparent：圆角边缘的抗锯齿
         会把透明基色混进合成，白基色就会在四角留下白点（见 4.7.0 的教训）。 -->
    <Grid x:Name="Frame">
        <!-- 投影：单独一块圆角矩形上效果 —— 便宜，也不会把整个内容卷进效果缓存 -->
        <Border x:Name="ShadowHost" Margin="14,10,14,20" CornerRadius="20"
                Background="{DynamicResource WindowBase}" IsHitTestVisible="False"
                Effect="{DynamicResource WindowShadow}"/>

        <Border x:Name="Shell" Margin="14,10,14,20" CornerRadius="20"
                Background="{DynamicResource WindowBase}">
            <Grid x:Name="ShellBody">
        <!-- 玻璃的底衬：一张有结构的壁纸。
             玻璃要被“看见”，背后必须有能被模糊掉的细节 —— 纯渐变模糊前后没有差别。 -->
        <Grid x:Name="Backdrop" ClipToBounds="True">
            <Image x:Name="BackdropImage" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle Fill="{DynamicResource BackdropVeil}" IsHitTestVisible="False"/>
        </Grid>

        <!-- 窗口外缘光边：上受光、下沉影，圆角是从这里“立”起来的 -->
        <Border x:Name="ShellRim" CornerRadius="20" BorderThickness="1" IsHitTestVisible="False"
                BorderBrush="{DynamicResource ShellRim}"/>

        <Grid x:Name="ContentRoot">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentShift" Y="0"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部：品牌 + 窗口按钮 -->
            <Grid Grid.Row="0" Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/suda-logo.png" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" ToolTip="作者：溪边木"/>
                    <TextBlock Text="SudaLink" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                    <Border Style="{StaticResource Tag}" Margin="9,0,0,0" Padding="7,1">
                        <TextBlock Text="苏大校园网" FontSize="9" Foreground="{DynamicResource Sub}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource Caption}" Click="MinimizeWindow" ToolTip="最小化到托盘">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource Caption}" Click="MaximizeWindow" ToolTip="最大化">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}" Click="CloseWindow" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 页面 -->
            <Grid Grid.Row="1" Margin="20,8,20,0">

                <!-- 概览 -->
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 状态卡：只讲一件事，字号拉开 -->
                    <controls:GlassPanel x:Name="StatusCard" Grid.Row="0" CornerRadius="14" Padding="22,20"
                                         Backdrop="{Binding ElementName=BackdropImage}"
                                         Fill="{DynamicResource GlassStrong}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse x:Name="StatusHalo" Width="14" Height="14" Fill="{DynamicResource Muted}"
                                                 Opacity="0" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource Muted}"/>
                                    </Grid>
                                    <TextBlock x:Name="StatusTitle" Text="正在检测网络" FontSize="23"
                                               FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="24,7,0,0">
                                <TextBlock x:Name="StatusMessage" Text="正在检测网络连接" FontSize="12"
                                           Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                <TextBlock x:Name="StatusMeta" Text="尚未检测" FontSize="10"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="24,14,0,0">
                                <Border Background="{DynamicResource SurfaceSoft}" CornerRadius="10" Padding="9,4"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="CurrentNumber" Text="未选择账号" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource InkSoft}"/>
                                        <Border x:Name="CurrentCarrierTag" Style="{StaticResource Tag}" Margin="6,0,0,0"
                                                Padding="6,0" Visibility="Collapsed">
                                            <TextBlock x:Name="CurrentCarrier" FontSize="9"
                                                       Foreground="{DynamicResource Sub}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="HotspotStatus" Text="" FontSize="9.5"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </controls:GlassPanel>

                    <!-- 三块功能瓷片：常用动作挪到手指够得着的地方 -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ConnectButton" Grid.Column="0" Style="{StaticResource TileAccent}"
                                Click="ConnectNow" ToolTip="立即检测并连接校园网">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="立即连接" FontSize="10.5" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="PauseButton" Grid.Column="2" Style="{StaticResource TileOn}"
                                Click="TogglePause" ToolTip="点击暂停自动重连">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="PauseText" Text="重连守护中" FontSize="10.5"
                                           Margin="0,7,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="HotspotButton" Grid.Column="4" Style="{StaticResource TileOff}"
                                Click="StartHotspot" ToolTip="点击开启移动热点">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="HotspotText" Text="热点未开启" FontSize="10.5"
                                           Margin="0,7,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 最近活动：第二块玻璃，页面有层次，玻璃也才看得出来 -->
                    <controls:GlassPanel Grid.Row="2" Margin="0,14,0,0" CornerRadius="14" Padding="0"
                                         Fill="{DynamicResource GlassSoft}" Backdrop="{Binding ElementName=BackdropImage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource BandFill}" CornerRadius="14,14,0,0"
                                BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1"
                                Padding="14,11,8,9">
                            <Grid>
                                <TextBlock Text="最近活动" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="复制" Style="{StaticResource Link}" Click="CopyLogs"/>
                                    <Button Content="清空" Style="{StaticResource Link}" Click="ClearLogs"
                                            Margin="2,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LogsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                 Margin="12,6,4,4" ItemContainerStyle="{StaticResource LogRow}"
                                 VerticalAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="0.82"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </ListBox.OpacityMask>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" FontSize="9.5"
                                                   Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/>
                                        <Ellipse x:Name="LevelDot" Grid.Column="1" Width="5" Height="5"
                                                 Fill="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,6,8,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11.5"
                                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="警告">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="错误">
                                            <Setter TargetName="LevelDot" Property="Fill" Value="{DynamicResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Background="{DynamicResource BandFill}" CornerRadius="0,0,14,14"
                                BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"
                                Padding="14,8,10,10">
                            <TextBlock x:Name="LogsFooter" Text="网关 10.9.1.3" FontSize="9"
                                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                    </controls:GlassPanel>
                </Grid>

                <!-- 账号 -->
                <ScrollViewer x:Name="AccountsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <controls:GlassPanel CornerRadius="14" Padding="10,8" Fill="{DynamicResource GlassStrong}" Backdrop="{Binding ElementName=BackdropImage}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="8,2,4,1">
                                    <TextBlock Text="全部账号" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
                                    <Button Content="添加" Style="{StaticResource Link}" Foreground="{DynamicResource Accent}"
                                            HorizontalAlignment="Right" Click="NewAccount"/>
                                </Grid>
                                <ListBox x:Name="AccountsList" Grid.Row="1" Background="Transparent"
                                         BorderThickness="0" Margin="0,0,2,0"
                                         ItemContainerStyle="{StaticResource Row}"
                                         SelectionChanged="AccountSelected"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Number}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplayDetails}" FontSize="10"
                                                               Foreground="{DynamicResource Muted}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <Border Style="{StaticResource Tag}" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Background="{DynamicResource SelFill}"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="当前" FontSize="9" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="1" Text="还没有账号，点击右上角「添加」开始"
                                           FontSize="10.5" Foreground="{DynamicResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=AccountsList}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </controls:GlassPanel>

                        <controls:GlassPanel Margin="0,10,0,0" CornerRadius="14" Padding="18,16"
                                             Fill="{DynamicResource GlassStrong}" Backdrop="{Binding ElementName=BackdropImage}">
                            <StackPanel>
                                <TextBlock x:Name="EditorTitle" Text="添加账号" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Ink}"/>
                                <TextBlock x:Name="EditorHint" Text="填写学号并选择运营商即可" FontSize="10.5"
                                           Foreground="{DynamicResource Muted}" Margin="0,3,0,16"/>

                                <TextBlock Text="学号" FontSize="11.5" Foreground="{DynamicResource Sub}" Margin="0,0,0,6"/>
                                <TextBox x:Name="AccountNumberInput" Style="{StaticResource Field}" MaxLength="32"/>

                                <TextBlock Text="运营商" FontSize="11.5" Foreground="{DynamicResource Sub}" Margin="0,14,0,6"/>
                                <Border Background="{DynamicResource SurfaceSoft}" CornerRadius="15" Padding="3" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CarrierCampus" Content="校园网" Style="{StaticResource Segment}"
                                                     GroupName="Carrier" IsChecked="True"/>
                                        <RadioButton x:Name="CarrierMobile" Content="移动" Style="{StaticResource Segment}"
                                                     GroupName="Carrier"/>
                                        <RadioButton x:Name="CarrierUnicom" Content="联通" Style="{StaticResource Segment}"
                                                     GroupName="Carrier"/>
                                        <RadioButton x:Name="CarrierTelecom" Content="电信" Style="{StaticResource Segment}"
                                                     GroupName="Carrier"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="密码" FontSize="11.5" Foreground="{DynamicResource Sub}"/>
                                    <CheckBox x:Name="ShowPassword" Content="显示密码" Style="{StaticResource Toggle}"
                                              HorizontalAlignment="Right" Click="TogglePasswordVisibility"/>
                                </Grid>
                                <Grid>
                                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource Secret}"/>
                                    <TextBox x:Name="PasswordVisible" Style="{StaticResource Field}" Visibility="Collapsed"/>
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="启用此账号" FontSize="12.5" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="停用后不会参与自动登录" FontSize="10" Foreground="{DynamicResource Muted}"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AccountEnabled" Style="{StaticResource Switch}" IsChecked="True"
                                              HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="保存账号" Style="{StaticResource Primary}" Width="100" Click="SaveAccount"/>
                                        <Button Content="设为当前" Style="{StaticResource Ghost}" Width="92"
                                                Click="SetCurrentAccount" Margin="7,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="删除账号" Style="{StaticResource Link}" Foreground="{DynamicResource Danger}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="DeleteAccount"/>
                                </Grid>
                            </StackPanel>
                        </controls:GlassPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 设置 -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <controls:GlassPanel CornerRadius="14" Padding="18,4" Fill="{DynamicResource GlassStrong}" Backdrop="{Binding ElementName=BackdropImage}">
                            <StackPanel>
                                <Grid Height="52">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="外观" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="深色稳重，浅色清爽" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SurfaceSoft}" CornerRadius="15" Padding="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeDark" Content="深色" Style="{StaticResource Segment}"
                                                         GroupName="Theme" Click="ThemeChanged"/>
                                            <RadioButton x:Name="ThemeLight" Content="浅色" Style="{StaticResource Segment}"
                                                         GroupName="Theme" Click="ThemeChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource LineSoft}"/>

                                <Grid Height="52">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="自动重连" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="检测到未联网时自动登录校园网" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoReconnectSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" Click="ToggleAutoReconnect"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource LineSoft}"/>

                                <Grid Height="52">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="联网后自动开启热点" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="认证成功时自动打开移动热点" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="系统设置" Style="{StaticResource Link}" Click="OpenHotspotSettings"
                                                Margin="0,0,6,0"/>
                                        <CheckBox x:Name="AutoHotspotSwitch" Style="{StaticResource Switch}"
                                                  Click="ToggleAutoHotspot"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource LineSoft}"/>

                                <Grid Height="52">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="管理员权限" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="自动开启热点需要管理员权限" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Content="以管理员身份重启" Style="{StaticResource Ghost}"
                                            FontSize="11.5" Padding="10,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="RelaunchElevated"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource LineSoft}"/>

                                <Grid Height="52">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="开机自动启动" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="登录 Windows 后在后台静默运行" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Right" Click="ToggleAutoStart"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource LineSoft}"/>

                                <Grid Height="62">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="检测间隔" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                        <TextBlock Text="联网正常时的状态轮询频率" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SurfaceSoft}" CornerRadius="15" Padding="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Interval5" Content="5 秒" Style="{StaticResource Segment}"
                                                         GroupName="Interval" Click="IntervalChanged"/>
                                            <RadioButton x:Name="Interval10" Content="10 秒" Style="{StaticResource Segment}"
                                                         GroupName="Interval" Click="IntervalChanged"/>
                                            <RadioButton x:Name="Interval30" Content="30 秒" Style="{StaticResource Segment}"
                                                         GroupName="Interval" Click="IntervalChanged"/>
                                            <RadioButton x:Name="Interval60" Content="60 秒" Style="{StaticResource Segment}"
                                                         GroupName="Interval" Click="IntervalChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </controls:GlassPanel>

                        <controls:GlassPanel CornerRadius="14" Padding="18,14" Margin="0,10,0,0"
                                             Fill="{DynamicResource GlassStrong}" Backdrop="{Binding ElementName=BackdropImage}">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="认证网关" FontSize="12" Foreground="{DynamicResource Ink}"/>
                                    <TextBlock Text="默认 10.9.1.3，仅校内私有地址" FontSize="10"
                                               Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBox x:Name="GatewayInput" Style="{StaticResource Field}" Width="128"/>
                                    <Button Content="应用" Style="{StaticResource Ghost}" Click="ApplyGateway"
                                            Margin="7,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </controls:GlassPanel>

                        <Grid Margin="6,12,4,0">
                            <TextBlock Text="设置修改后立即生效并自动保存 · v4.8.1" FontSize="9.5"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <TextBlock Text="溪边木" FontSize="9.5" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       ToolTip="作者：溪边木"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部浮动玻璃标签栏：全胶囊造型（高 56，圆角 28），是整窗最“液态”的一块 -->
            <controls:GlassPanel Grid.Row="2" Height="56" Margin="18,10,18,16" CornerRadius="28" Padding="6"
                                 Fill="{DynamicResource GlassMedium}" Backdrop="{Binding ElementName=BackdropImage}" Shadow="{StaticResource FloatShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton x:Name="TabOverview" Style="{StaticResource Tab}" GroupName="Nav"
                                 IsChecked="True" Click="ShowDashboard">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="概览" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabAccounts" Grid.Column="1" Style="{StaticResource Tab}" GroupName="Nav"
                                 Click="ShowAccounts">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="账号" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabSettings" Grid.Column="2" Style="{StaticResource Tab}" GroupName="Nav"
                                 Click="ShowSettings">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="设置" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </controls:GlassPanel>
        </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
