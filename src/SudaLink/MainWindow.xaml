<Window x:Class="SudaLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SudaLink" Width="740" Height="492" MinWidth="690" MinHeight="460"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Closing="OnWindowClosing" Closed="OnWindowClosed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 忙碌状态的光晕呼吸 -->
        <Storyboard x:Key="StatusPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.4" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="HaloScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.4" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="StatusHalo" Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0" Duration="0:0:1.2" RepeatBehavior="Forever"
                             EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>

        <!-- 窗口入场 -->
        <Storyboard x:Key="Entrance">
            <DoubleAnimation Storyboard.TargetName="Shell" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="ShellShift" Storyboard.TargetProperty="Y"
                             From="10" To="0" Duration="0:0:0.32" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource Entrance}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="Shell" Background="{StaticResource Canvas}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShellShift" Y="0"/>
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#E4E7EC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧栏：通高，与标题栏连成一体 -->
            <Border Grid.Column="0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="10,0,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                        <Image Source="Assets/suda-logo.png" Width="26" Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SudaLink" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="苏大校园网" FontSize="9.5" Foreground="{StaticResource Muted}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="Nav"
                                     IsChecked="True" Click="ShowDashboard" Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="概览" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" GroupName="Nav"
                                     Click="ShowAccounts" Margin="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="账号" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="Nav"
                                     Click="ShowSettings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="设置" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="2,0,2,0">
                        <Border Background="#F7F8FA" CornerRadius="7" Padding="8,6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SideStatusDot" Width="6" Height="6"
                                             Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SideStatus" Text="检测中" FontSize="10.5"
                                               Foreground="{StaticResource Sub}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="SideAccount" Text="未选择账号" FontSize="10"
                                           Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="1,8,1,0">
                            <TextBlock x:Name="VersionText" Text="v3.2" FontSize="9.5"
                                       Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="溪边木" FontSize="9.5" Foreground="#C3C8D1"
                                       HorizontalAlignment="Right" ToolTip="作者：溪边木" Cursor="Arrow"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：标题按钮 + 内容 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinButton" Style="{StaticResource Caption}" Click="MinimizeWindow" ToolTip="最小化到托盘">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource Caption}" Click="MaximizeWindow" ToolTip="最大化">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionClose}" Click="CloseWindow" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Row="1" Margin="18,0,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="PageTitle" Text="概览" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="PageSubtitle" Text="校园网连接状态与自动守护" FontSize="10.5"
                                   Foreground="{StaticResource Sub}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">

                        <!-- 概览 -->
                        <Grid x:Name="DashboardPage">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="StatusCard" Grid.Row="0" Style="{StaticResource Card}" Padding="18,15">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Ellipse x:Name="StatusHalo" Width="11" Height="11"
                                                         Fill="{StaticResource Muted}" Opacity="0"
                                                         RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="HaloScale" ScaleX="1" ScaleY="1"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="StatusDot" Width="9" Height="9"
                                                         Fill="{StaticResource Muted}"/>
                                            </Grid>
                                            <TextBlock x:Name="StatusTitle" Text="正在检测网络" FontSize="19"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="CurrentNumber" Text="未选择账号" FontSize="11.5"
                                                           FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                                                <Border x:Name="CurrentCarrierTag" Style="{StaticResource Tag}"
                                                        Margin="6,0,0,0" Visibility="Collapsed">
                                                    <TextBlock x:Name="CurrentCarrier" FontSize="9.5"
                                                               Foreground="{StaticResource Sub}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="当前优先账号" FontSize="9.5" Foreground="{StaticResource Muted}"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <TextBlock x:Name="StatusMessage" Text="正在检测网络连接" FontSize="11.5"
                                                   Foreground="{StaticResource Sub}" Margin="19,5,120,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="StatusMeta" Text="尚未检测" FontSize="9.5"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                                                   Margin="0,5,0,0"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ConnectButton" Content="立即连接" Style="{StaticResource Primary}"
                                                    Click="ConnectNow"/>
                                            <Button x:Name="PauseButton" Style="{StaticResource GhostOn}"
                                                    Click="TogglePause" Margin="6,0,0,0"
                                                    ToolTip="点击暂停自动重连">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="PauseDot" Width="6" Height="6" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"
                                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock x:Name="PauseText" Text="重连守护中" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="HotspotButton" Style="{StaticResource GhostOff}"
                                                    Click="StartHotspot" Margin="6,0,0,0"
                                                    ToolTip="点击开启移动热点">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="HotspotDot" Width="6" Height="6" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"
                                                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock x:Name="HotspotText" Text="热点未开启" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="HotspotStatus" Text="" FontSize="9.5"
                                                   Foreground="{StaticResource Muted}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="170"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="16,9,8,3">
                                        <TextBlock Text="最近活动" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="复制" Style="{StaticResource Link}" Click="CopyLogs"/>
                                            <Button Content="清空" Style="{StaticResource Link}" Click="ClearLogs"
                                                    Margin="1,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <ListBox x:Name="LogsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                             Margin="10,0,10,8" ItemContainerStyle="{StaticResource LogRow}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2.5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}" FontSize="9.5"
                                                               Foreground="{StaticResource Muted}"/>
                                                    <Ellipse x:Name="LevelDot" Grid.Column="1" Width="5" Height="5"
                                                             Fill="#C6CBD4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="11"
                                                               Foreground="#374151" TextWrapping="Wrap"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="警告">
                                                        <Setter TargetName="LevelDot" Property="Fill" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="错误">
                                                        <Setter TargetName="LevelDot" Property="Fill" Value="{StaticResource Danger}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 账号 -->
                        <Grid x:Name="AccountsPage" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="214"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="14,9,6,2">
                                        <TextBlock Text="全部账号" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
                                        <Button Content="添加" Style="{StaticResource Link}" Foreground="{StaticResource Accent}"
                                                HorizontalAlignment="Right" Click="NewAccount"/>
                                    </Grid>
                                    <ListBox x:Name="AccountsList" Grid.Row="1" Background="Transparent"
                                             BorderThickness="0" Margin="5,0,5,6"
                                             ItemContainerStyle="{StaticResource Row}"
                                             SelectionChanged="AccountSelected"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DisplayDetails}" FontSize="10"
                                                                   Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource TagAccent}" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="当前" FontSize="9" Foreground="{StaticResource Accent}"/>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="1" Text="还没有账号&#x0a;点击右上角「添加」开始"
                                               FontSize="10.5" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" LineHeight="18" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=AccountsList}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                                <StackPanel>
                                    <TextBlock x:Name="EditorTitle" Text="添加账号" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}"/>
                                    <TextBlock x:Name="EditorHint" Text="填写学号并选择运营商即可" FontSize="10"
                                               Foreground="{StaticResource Muted}" Margin="0,3,0,13"/>

                                    <TextBlock Text="学号" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="AccountNumberInput" Style="{StaticResource Field}" MaxLength="32"/>

                                    <TextBlock Text="运营商" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,12,0,5"/>
                                    <Border Background="#F3F4F7" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="CarrierCampus" Content="校园网" Style="{StaticResource Segment}"
                                                         GroupName="Carrier" IsChecked="True"/>
                                            <RadioButton x:Name="CarrierMobile" Content="移动" Style="{StaticResource Segment}"
                                                         GroupName="Carrier"/>
                                            <RadioButton x:Name="CarrierUnicom" Content="联通" Style="{StaticResource Segment}"
                                                         GroupName="Carrier"/>
                                            <RadioButton x:Name="CarrierTelecom" Content="电信" Style="{StaticResource Segment}"
                                                         GroupName="Carrier"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,12,0,5">
                                        <TextBlock Text="密码" FontSize="11" Foreground="{StaticResource Sub}"/>
                                        <CheckBox x:Name="ShowPassword" Content="显示密码" Style="{StaticResource Toggle}"
                                                  HorizontalAlignment="Right" Click="TogglePasswordVisibility"/>
                                    </Grid>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource Secret}"/>
                                        <TextBox x:Name="PasswordVisible" Style="{StaticResource Field}" Visibility="Collapsed"/>
                                    </Grid>

                                    <Grid Margin="0,13,0,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="启用此账号" FontSize="12" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="停用后不会参与自动登录" FontSize="10" Foreground="{StaticResource Muted}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="AccountEnabled" Style="{StaticResource Switch}" IsChecked="True"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,15,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="保存账号" Style="{StaticResource Primary}" Width="94" Click="SaveAccount"/>
                                            <Button Content="设为当前" Style="{StaticResource Ghost}" Width="88"
                                                    Click="SetCurrentAccount" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="删除账号" Style="{StaticResource Link}" Foreground="{StaticResource Danger}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="DeleteAccount"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 设置 -->
                        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="18,4">
                                    <StackPanel>
                                        <Grid Height="54">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="自动重连" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="检测到未联网时自动登录校园网" FontSize="10"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoReconnectSwitch" Style="{StaticResource Switch}"
                                                      HorizontalAlignment="Right" Click="ToggleAutoReconnect"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource Line}"/>

                                        <Grid Height="54">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="联网后自动开启热点" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="认证成功时自动打开 Windows 移动热点" FontSize="10"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="系统热点设置" Style="{StaticResource Link}" Click="OpenHotspotSettings"
                                                        Margin="0,0,6,0"/>
                                                <CheckBox x:Name="AutoHotspotSwitch" Style="{StaticResource Switch}"
                                                          Click="ToggleAutoHotspot"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource Line}"/>

                                        <Grid Height="54">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="开机自动启动" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="登录 Windows 后在后台静默运行" FontSize="10"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}"
                                                      HorizontalAlignment="Right" Click="ToggleAutoStart"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource Line}"/>

                                        <Grid Height="54">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="关闭时最小化到托盘" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="关闭窗口后仍在后台守护网络" FontSize="10"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource Switch}"
                                                      HorizontalAlignment="Right" Click="ToggleCloseToTray"/>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource Line}"/>

                                        <Grid Height="58">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="检测间隔" FontSize="12" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="联网正常时的状态轮询频率" FontSize="10"
                                                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Background="#F3F4F7" CornerRadius="9" Padding="3"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="Interval5" Content="5 秒" Style="{StaticResource Segment}"
                                                                 GroupName="Interval" Click="IntervalChanged"/>
                                                    <RadioButton x:Name="Interval10" Content="10 秒" Style="{StaticResource Segment}"
                                                                 GroupName="Interval" Click="IntervalChanged"/>
                                                    <RadioButton x:Name="Interval30" Content="30 秒" Style="{StaticResource Segment}"
                                                                 GroupName="Interval" Click="IntervalChanged"/>
                                                    <RadioButton x:Name="Interval60" Content="60 秒" Style="{StaticResource Segment}"
                                                                 GroupName="Interval" Click="IntervalChanged"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="18,11" Margin="0,10,0,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="认证网关" FontSize="12" Foreground="{StaticResource Ink}"/>
                                            <TextBlock Text="默认 10.9.1.3，仅支持校内私有地址" FontSize="10"
                                                       Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBox x:Name="GatewayInput" Style="{StaticResource Field}" Width="124"/>
                                            <Button Content="应用" Style="{StaticResource Ghost}" Click="ApplyGateway"
                                                    Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="设置修改后立即生效并自动保存" FontSize="9.5"
                                           Foreground="{StaticResource Muted}" Margin="3,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
