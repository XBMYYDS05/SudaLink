<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 浅色面板：Daylight（白玻璃浮在淡彩背景上） ===== -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="Ink" Color="#0F1319"/>
    <SolidColorBrush x:Key="InkSoft" Color="#262D37"/>
    <SolidColorBrush x:Key="Sub" Color="#444D5B"/>
    <SolidColorBrush x:Key="Muted" Color="#5C6675"/>

    <!-- 品牌 -->
    <SolidColorBrush x:Key="Accent" Color="#C8203A"/>
    <SolidColorBrush x:Key="AccentDeep" Color="#9E1730"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#C8203A"/>
    <SolidColorBrush x:Key="SelFill" Color="#52FFFFFF"/>
    <SolidColorBrush x:Key="SelEdge" Color="#59C8203A"/>
    <SolidColorBrush x:Key="TabFillA" Color="#B8FFFFFF"/>
    <Color x:Key="TabFillAColor">#B8FFFFFF</Color>
    <SolidColorBrush x:Key="TabFillB" Color="#A6FFFFFF"/>
    <Color x:Key="TabFillBColor">#A6FFFFFF</Color>
    <SolidColorBrush x:Key="TabEdge" Color="#F2FFFFFF"/>

    <!-- 语义 -->
    <SolidColorBrush x:Key="Success" Color="#0E9F6E"/>
    <SolidColorBrush x:Key="SuccessText" Color="#0A7F58"/>
    <SolidColorBrush x:Key="SuccessFill" Color="#1F0E9F6E"/>
    <SolidColorBrush x:Key="SuccessEdge" Color="#4D0E9F6E"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B3D"/>
    <SolidColorBrush x:Key="DangerText" Color="#B0273A"/>
    <SolidColorBrush x:Key="DangerFill" Color="#1FC42B3D"/>
    <SolidColorBrush x:Key="DangerEdge" Color="#4DC42B3D"/>
    <SolidColorBrush x:Key="Warn" Color="#B86A10"/>

    <!-- 控件发丝边：上亮下暗，比卡片外缘弱一档，避免白底上出现"双描边" -->
    <LinearGradientBrush x:Key="ControlEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- 玻璃：面板整体比背景亮一档，配合投影才能从高对比底色上"浮"起来 -->
    <SolidColorBrush x:Key="GlassStrong" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="GlassMedium" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="GlassSoft" Color="#24FFFFFF"/>
    <Color x:Key="GlassTopA">#2EFFFFFF</Color>
    <Color x:Key="GlassTopB">#14FFFFFF</Color>
    <Color x:Key="GlassTopC">#0AFFFFFF</Color>
    <Color x:Key="GlassBottom">#12000000</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#C4FFFFFF" Offset="0.4"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.74"/>
        <GradientStop Color="#380A1424" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="16" ShadowDepth="3" Direction="270"
                      Color="#1B2C4A" Opacity="0.2" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="TabShadow" BlurRadius="12" ShadowDepth="2" Direction="270"
                      Color="#1B2C4A" Opacity="0.14" RenderingBias="Performance"/>
    <DropShadowEffect x:Key="FloatShadow" BlurRadius="18" ShadowDepth="5" Direction="270"
                      Color="#1B2C4A" Opacity="0.18" RenderingBias="Performance"/>

    <Color x:Key="SpecularCore">#4DFFFFFF</Color>
    <Color x:Key="SpecularMid">#14FFFFFF</Color>
    <Color x:Key="RimInnerA">#59FFFFFF</Color>
    <Color x:Key="RimInnerB">#1F0A1424</Color>
    <Color x:Key="TopLineA">#B3FFFFFF</Color>
    <Color x:Key="TopLineB">#FFFFFFFF</Color>
    <!-- 液态玻璃：边缘镜圈的棱镜色散（冷色偏上、暖色偏下，透明度都很低） -->
    <Color x:Key="ChromaA">#14A8D8FF</Color>
    <Color x:Key="ChromaB">#00D6C2FF</Color>
    <Color x:Key="ChromaC">#12FF9FC4</Color>
    <!-- 底面透光 -->
    <Color x:Key="InnerGlowBottom">#3DFFFFFF</Color>
    <!-- 整个窗口的外投影与边框 -->
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="16" ShadowDepth="4" Direction="270"
                      Color="#0E1E36" Opacity="0.34" RenderingBias="Performance"/>
    <Color x:Key="WindowEdgeTop">#B3FFFFFF</Color>
    <Color x:Key="WindowEdgeBottom">#120B1A33</Color>
    <SolidColorBrush x:Key="PrimaryEdge" Color="#66FFFFFF"/>
    <Color x:Key="PrimaryGloss">#73FFFFFF</Color>

    <!-- 控件表面 -->
    <SolidColorBrush x:Key="SurfaceSoft" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="LineSoft" Color="#1F0B1A33"/>
    <SolidColorBrush x:Key="BandFill" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="HoverWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CaptionHover" Color="#14000000"/>
    <SolidColorBrush x:Key="CloseHover" Color="#D93A4B"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#1A000000"/>
    <SolidColorBrush x:Key="ScrollThumbHot" Color="#4A000000"/>
    <Color x:Key="PrimaryA">#E03048</Color>
    <Color x:Key="PrimaryB">#A8162C</Color>
    <Color x:Key="SwitchA">#E03048</Color>
    <Color x:Key="SwitchB">#A8162C</Color>
    <SolidColorBrush x:Key="SwitchTrack" Color="#26000000"/>

    <!-- 背景（Color 供 GradientStop，WindowBase 供窗口兜底） -->
    <SolidColorBrush x:Key="WindowBase" Color="#7E93E2"/>
    <Color x:Key="BgBase1">#F8F9FD</Color>
    <Color x:Key="BgBase2">#EEF1FA</Color>
    <Color x:Key="BgBase3">#FDF4F6</Color>
    <Color x:Key="AuroraBlue">#8CA8C4FF</Color>
    <Color x:Key="AuroraBlueMid">#3DA0B8F2</Color>
    <Color x:Key="AuroraRose">#7AFFC4D2</Color>
    <Color x:Key="AuroraRoseMid">#33F7AFC0</Color>
    <Color x:Key="AuroraViolet">#6BD9C8FF</Color>
    <Color x:Key="AuroraVioletMid">#2EB9A4F5</Color>
    <Color x:Key="AuroraMint">#5FBFEBDD</Color>
    <Color x:Key="AuroraMintMid">#24A3DECF</Color>
    <Color x:Key="GrainTint">#000000</Color>

    <!-- 玻璃底衬（壁纸）：必须有结构，玻璃才“透”得出来 -->
    <ImageBrush x:Key="BackdropBrush" ImageSource="pack://application:,,,/Assets/backdrop-light.jpg"
                Stretch="UniformToFill"/>
    <SolidColorBrush x:Key="BackdropVeil" Color="#00FFFFFF"/>
</ResourceDictionary>
