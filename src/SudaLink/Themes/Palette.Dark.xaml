<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色面板：Midnight Aurora ===== -->

    <!-- 文字 -->
    <SolidColorBrush x:Key="Ink" Color="#F3F6FC"/>
    <SolidColorBrush x:Key="InkSoft" Color="#E4EBF7"/>
    <SolidColorBrush x:Key="Sub" Color="#C2CDDE"/>
    <SolidColorBrush x:Key="Muted" Color="#A6B2C6"/>

    <!-- 品牌 -->
    <SolidColorBrush x:Key="Accent" Color="#FF4157"/>
    <SolidColorBrush x:Key="AccentDeep" Color="#D42440"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FF8B99"/>
    <SolidColorBrush x:Key="SelFill" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="SelEdge" Color="#4DFF4157"/>
    <SolidColorBrush x:Key="TabFillA" Color="#3DFFFFFF"/>
    <Color x:Key="TabFillAColor">#3DFFFFFF</Color>
    <SolidColorBrush x:Key="TabFillB" Color="#2EFFFFFF"/>
    <Color x:Key="TabFillBColor">#2EFFFFFF</Color>
    <SolidColorBrush x:Key="TabEdge" Color="#5CFFFFFF"/>

    <!-- 语义 -->
    <SolidColorBrush x:Key="Success" Color="#2FE39A"/>
    <SolidColorBrush x:Key="SuccessText" Color="#5CF0BB"/>
    <SolidColorBrush x:Key="SuccessFill" Color="#292BE08F"/>
    <SolidColorBrush x:Key="SuccessEdge" Color="#592BE08F"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5F73"/>
    <SolidColorBrush x:Key="DangerText" Color="#FF97A3"/>
    <SolidColorBrush x:Key="DangerFill" Color="#26FF5F73"/>
    <SolidColorBrush x:Key="DangerEdge" Color="#59FF5F73"/>
    <SolidColorBrush x:Key="Warn" Color="#FFB733"/>

    <!-- 玻璃 -->
    <SolidColorBrush x:Key="GlassStrong" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="GlassMedium" Color="#16FFFFFF"/>
    <SolidColorBrush x:Key="GlassSoft" Color="#10FFFFFF"/>
    <Color x:Key="GlassTopA">#0AFFFFFF</Color>
    <Color x:Key="GlassTopB">#00FFFFFF</Color>
    <Color x:Key="GlassTopC">#0AFFFFFF</Color>
    <Color x:Key="GlassBottom">#2E000000</Color>
    <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Color="#7AFFFFFF" Offset="0"/>
        <GradientStop Color="#38FFFFFF" Offset="0.42"/>
        <GradientStop Color="#17FFFFFF" Offset="0.76"/>
        <GradientStop Color="#66000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- 光边分档（GlassPanel 每个面板一份实例，可被指针带着旋转） -->
    <Color x:Key="EdgeA">#7AFFFFFF</Color>
    <Color x:Key="EdgeB">#38FFFFFF</Color>
    <Color x:Key="EdgeC">#17FFFFFF</Color>
    <Color x:Key="EdgeD">#66000000</Color>
    <!-- 悬停顶部径向光泽 -->
    <Color x:Key="GlossTop">#33FFFFFF</Color>

    <!-- 控件发丝边 -->
    <LinearGradientBrush x:Key="ControlEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#47FFFFFF" Offset="0"/>
        <GradientStop Color="#33000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- 深色下的面板投影只用来"压住"边界，不能当暗角用：
         纯黑 + 大半径叠在深底上就是一圈脏晕，玻璃反而显得不干净。
         半径收小、透明度压到几乎看不见，深度感交给边缘光。 -->
    <DropShadowEffect x:Key="PanelShadow" BlurRadius="9" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.18" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="TabShadow" BlurRadius="7" ShadowDepth="1" Direction="270"
                      Color="#000000" Opacity="0.20" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="FloatShadow" BlurRadius="14" ShadowDepth="3" Direction="270"
                      Color="#000000" Opacity="0.30" RenderingBias="Quality"/>

    <Color x:Key="SpecularCore">#2EFFFFFF</Color>
    <Color x:Key="SpecularMid">#0CFFFFFF</Color>
    <Color x:Key="RimInnerA">#3DFFFFFF</Color>
    <Color x:Key="RimInnerB">#1FFFFFFF</Color>
    <Color x:Key="TopLineA">#52FFFFFF</Color>
    <Color x:Key="TopLineB">#8CFFFFFF</Color>
    <!-- 液态玻璃：边缘镜圈的棱镜色散 -->
    <Color x:Key="ChromaA">#1FA8D8FF</Color>
    <Color x:Key="ChromaB">#00D6C2FF</Color>
    <Color x:Key="ChromaC">#1BFF9FC4</Color>
    <!-- 底面透光 -->
    <Color x:Key="InnerGlowBottom">#17FFFFFF</Color>
    <!-- 整个窗口的外投影与边框（分层窗口自绘） -->
    <DropShadowEffect x:Key="WindowShadow" BlurRadius="24" ShadowDepth="8" Direction="270"
                      Color="#000000" Opacity="0.58" RenderingBias="Quality"/>
    <!-- 窗口外缘光边：上受光、下沉影 -->
    <LinearGradientBrush x:Key="ShellRim" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.5"/>
        <GradientStop Color="#52000000" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="WindowEdgeTop">#52FFFFFF</Color>
    <Color x:Key="WindowEdgeBottom">#40000000</Color>
    <SolidColorBrush x:Key="PrimaryEdge" Color="#47FFFFFF"/>
    <Color x:Key="PrimaryGloss">#4DFFFFFF</Color>

    <!-- 控件表面 -->
    <SolidColorBrush x:Key="SurfaceSoft" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="LineSoft" Color="#1FFFFFFF"/>
    <!-- 卡内条带（列表头 / 页脚）：深色下用"压暗"分隔，加白会在这个位置堆出一层雾 -->
    <SolidColorBrush x:Key="BandFill" Color="#1A000000"/>
    <SolidColorBrush x:Key="HoverWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CaptionHover" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CloseHover" Color="#E6E8364A"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#21FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHot" Color="#5CFFFFFF"/>
    <Color x:Key="PrimaryA">#FF4A5F</Color>
    <Color x:Key="PrimaryB">#CE1F38</Color>
    <Color x:Key="SwitchA">#F04156</Color>
    <Color x:Key="SwitchB">#B4152B</Color>
    <SolidColorBrush x:Key="SwitchTrack" Color="#33FFFFFF"/>

    <!-- 背景（Color 供 GradientStop，WindowBase 供窗口兜底） -->
    <SolidColorBrush x:Key="WindowBase" Color="#04060C"/>
    <Color x:Key="BgBase1">#04060C</Color>
    <Color x:Key="BgBase2">#070A15</Color>
    <Color x:Key="BgBase3">#080A16</Color>
    <Color x:Key="AuroraBlue">#663A5BFF</Color>
    <Color x:Key="AuroraBlueMid">#262A3FB8</Color>
    <Color x:Key="AuroraRose">#3DE23A6E</Color>
    <Color x:Key="AuroraRoseMid">#16A62B52</Color>
    <Color x:Key="AuroraViolet">#3D7C4DFF</Color>
    <Color x:Key="AuroraVioletMid">#146038D6</Color>
    <Color x:Key="AuroraMint">#3314B8A6</Color>
    <Color x:Key="AuroraMintMid">#1284A79E</Color>
    <Color x:Key="GrainTint">#99FFFFFF</Color>

    <!-- 玻璃底衬（壁纸） -->
    <ImageBrush x:Key="BackdropBrush" ImageSource="pack://application:,,,/Assets/backdrop-dark.jpg"
                Stretch="UniformToFill"/>
    <SolidColorBrush x:Key="BackdropVeil" Color="#2E000000"/>
</ResourceDictionary>
